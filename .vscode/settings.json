{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "cSpell.enabled": true,
  "cSpell.checkLimit": 500,
  "eslint.enable": false,
  "prettier.enable": false,
  "typescript.preferences.importModuleSpecifier": "relative",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ef8e5b",
    "activityBar.background": "#ef8e5b",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#c5f9d7",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#ef8e5b",
    "statusBar.background": "#ea6e2d",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#cf5515",
    "statusBarItem.remoteBackground": "#ea6e2d",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#ea6e2d",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#ea6e2d99",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#ea6e2d"
}